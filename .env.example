# Runtime configuration for OTP Code Extractor API.
# Copy to .env and edit. All variables use the OTP_EXTRACTOR_ prefix.

# General
OTP_EXTRACTOR_ENVIRONMENT=development
OTP_EXTRACTOR_APP_NAME=OTP Code Extractor API
OTP_EXTRACTOR_APP_VERSION=1.0.0
OTP_EXTRACTOR_LOG_LEVEL=INFO
OTP_EXTRACTOR_LOG_FORMAT=console

# HTTP
OTP_EXTRACTOR_CORS_ORIGINS=["*"]
OTP_EXTRACTOR_CORS_ALLOW_CREDENTIALS=false
OTP_EXTRACTOR_REQUEST_TIMEOUT_SECONDS=30

# Rate limiting
OTP_EXTRACTOR_RATE_LIMIT_ENABLED=true
OTP_EXTRACTOR_RATE_LIMIT_PER_MINUTE=60
OTP_EXTRACTOR_RATE_LIMIT_BURST=20

# Auth (multi-tenant API keys)
OTP_EXTRACTOR_AUTH_ENABLED=false
OTP_EXTRACTOR_API_KEYS=
OTP_EXTRACTOR_API_KEY_HMAC_SECRET=please-change-me-in-production

# Argon2 password hashing
OTP_EXTRACTOR_ARGON2_TIME_COST=2
OTP_EXTRACTOR_ARGON2_MEMORY_COST=65536
OTP_EXTRACTOR_ARGON2_PARALLELISM=4

# Database
OTP_EXTRACTOR_DATABASE_URL=sqlite+aiosqlite:///./otp_extractor.db

# Redis
OTP_EXTRACTOR_REDIS_URL=redis://localhost:6379/0
OTP_EXTRACTOR_USE_IN_MEMORY_REDIS=false

# QR decoder
OTP_EXTRACTOR_QR_DECODER_ENABLED=true
OTP_EXTRACTOR_QR_DECODER_MODEL=detector_v1
OTP_EXTRACTOR_MAX_QR_IMAGE_BYTES=5242880

# OTP
OTP_EXTRACTOR_DEFAULT_ALGORITHM=SHA1
OTP_EXTRACTOR_DEFAULT_DIGITS=6
OTP_EXTRACTOR_DEFAULT_PERIOD=30
OTP_EXTRACTOR_MAX_BATCH_SIZE=100

# Observability
OTP_EXTRACTOR_METRICS_ENABLED=true
OTP_EXTRACTOR_AUDIT_LOG_ENABLED=true
